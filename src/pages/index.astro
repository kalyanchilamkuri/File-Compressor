---
import BaseLayout from '../layouts/BaseLayout.astro';
import Compressor from '../components/Compressor';
import { SEO_PAGES } from '../config/seoPages';
import { SITE } from '../config/site';

const FEATURES = [
  {
    title: 'Private by design',
    body: 'Files are compressed on your device. Nothing is uploaded, so there is nothing to leak or delete.',
  },
  {
    title: 'Hit an exact size',
    body: 'Pick “Under 100 KB”, “Email” or your own number and get the best quality that fits.',
  },
  {
    title: 'Every kind of file',
    body: 'Photos, PDFs, videos, audio and archives in one place. Mix them in a single drop.',
  },
  {
    title: 'Unlimited and offline',
    body: 'No signup, no watermarks, no daily limits. After your first visit it even works offline.',
  },
];

const FAQS = [
  {
    q: 'Is it really free?',
    a: `Yes. ${SITE.name} has no paid tiers for compression, no watermarks and no limits on how many files you compress.`,
  },
  {
    q: 'How can it be private if it’s a website?',
    a: 'The website delivers the compression code to your browser, and your browser does all the work. Your files never travel back over the internet. You can even disconnect from the internet after the page loads.',
  },
  {
    q: 'What’s the biggest file I can compress?',
    a: 'There is no fixed limit. Videos over 1 GB work on a typical laptop; the practical limit depends on your device’s memory and storage.',
  },
  {
    q: 'Which browsers are supported?',
    a: 'Recent versions of Chrome, Edge, Firefox and Safari on desktop and mobile. If something your browser lacks is needed, you’ll see a clear message.',
  },
];

const tools = SEO_PAGES.filter((p) => !p.parent);
const popular = SEO_PAGES.filter((p) => p.parent);

const structuredData = [
  {
    '@context': 'https://schema.org',
    '@type': 'FAQPage',
    mainEntity: FAQS.map((f) => ({
      '@type': 'Question',
      name: f.q,
      acceptedAnswer: { '@type': 'Answer', text: f.a },
    })),
  },
];
---

<BaseLayout structuredData={structuredData}>
  <section class="mx-auto flex max-w-3xl flex-col gap-8 px-4 pt-10 pb-16 sm:pt-14">
    <div class="text-center">
      <h1 class="text-3xl font-bold tracking-tight sm:text-5xl">Compress any file, privately</h1>
      <p class="mx-auto mt-3 max-w-xl text-lg text-slate-600 dark:text-slate-400">
        {SITE.name} shrinks images, PDFs, videos and audio right in your browser. Your files never
        leave your device. No signup, no limits.
      </p>
    </div>
    <Compressor client:load />
  </section>

  <section class="border-t border-slate-200 bg-slate-50 py-16 dark:border-slate-800 dark:bg-slate-900/40">
    <div class="mx-auto max-w-5xl px-4">
      <h2 class="text-center text-2xl font-semibold tracking-tight">Why {SITE.name}</h2>
      <ul class="mt-8 grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        {FEATURES.map((f) => (
          <li class="rounded-2xl border border-slate-200 bg-white p-5 dark:border-slate-800 dark:bg-slate-900">
            <h3 class="font-semibold">{f.title}</h3>
            <p class="mt-2 text-sm text-slate-600 dark:text-slate-400">{f.body}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="mx-auto max-w-5xl px-4 py-16">
    <h2 class="text-2xl font-semibold tracking-tight">Tools</h2>
    <ul class="mt-6 grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {tools.map((t) => (
        <li>
          <a
            href={`/${t.slug}`}
            class="block h-full rounded-xl border border-slate-200 p-4 transition hover:border-sky-400 hover:bg-sky-50/50 dark:border-slate-800 dark:hover:border-sky-700 dark:hover:bg-sky-950/30"
          >
            <span class="font-medium">{t.h1}</span>
            <span class="mt-1 block text-sm text-slate-600 dark:text-slate-400">{t.lead}</span>
          </a>
        </li>
      ))}
    </ul>
    <h3 class="mt-10 text-lg font-semibold">Popular tasks</h3>
    <ul class="mt-4 flex flex-wrap gap-2">
      {popular.map((t) => (
        <li>
          <a
            href={`/${t.slug}`}
            class="inline-block rounded-full border border-slate-200 px-3.5 py-1.5 text-sm text-slate-700 hover:border-sky-400 hover:text-sky-700 dark:border-slate-700 dark:text-slate-300 dark:hover:text-sky-300"
          >
            {t.h1}
          </a>
        </li>
      ))}
    </ul>
  </section>

  <section class="mx-auto max-w-3xl px-4 pb-20">
    <h2 class="text-2xl font-semibold tracking-tight">Questions</h2>
    <div class="mt-4 divide-y divide-slate-200 rounded-2xl border border-slate-200 dark:divide-slate-800 dark:border-slate-800">
      {FAQS.map((f) => (
        <details class="group px-5 py-4">
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 font-medium">
            {f.q}
            <span aria-hidden="true" class="text-slate-400 transition group-open:rotate-45">
              +
            </span>
          </summary>
          <p class="mt-2 text-slate-700 dark:text-slate-300">{f.a}</p>
        </details>
      ))}
    </div>
  </section>
</BaseLayout>
